<?xml version="1.0" encoding="UTF-8"?>
<!--
  Settings for the General page (contents/config/ConfigGeneral.qml).
  Every control persists here (docs/DESIGN.md §4).

  "Launch at login" deliberately has no entry: its storage is systemd's
  own unit enablement, queried and changed by contents/ui/DaemonAutostart.qml.
  A stored bool would only be a copy that can go stale.
-->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="" />
  <group name="General">
    <!-- Appearance. transparencyEnabled/transparencyPercent drive the
         flyout's panel tint via TransparencySettings.qml; the percent is
         OPACITY (alpha = percent/100). Not called "transparencyLevel":
         old installs still carry an orphaned key of that name (value
         100), and kcfg would pick it up instead of this default. -->
    <!-- Colour theme for the flyout, OSD toast and hover tooltip: "dark",
         "light" or "system" (follow the desktop's scheme). Read by
         ThemeSettings.qml; the settings page itself follows its window's
         scheme, not this (docs/DESIGN.md §6). -->
    <entry name="theme" type="String">
      <default>system</default>
    </entry>

    <entry name="transparencyEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="transparencyPercent" type="Int">
      <default>90</default>
    </entry>

    <!-- Volume step for the flyout's +/- buttons, slider stepSize and
         scroll steps (VolumeSettings.qml). -->
    <entry name="volumeStepDb" type="Double">
      <default>1.0</default>
    </entry>

    <!-- Volume limits. hard -10 and startup -40 are the settings mockup's
         defaults. All three range over -96..0 dB, enforced by the page's
         DbStepper, not here (kcfg <min>/<max> would only guard a
         hand-edited config file).

         volumeFloorDb is UI-only (trims the slider's unused low end) and
         never reaches the wire; only hardLimitDb feeds the protocol
         crate's clamp (docs/DESIGN.md §3). -->
    <entry name="volumeFloorDb" type="Double">
      <default>-50.0</default>
    </entry>
    <entry name="hardLimitDb" type="Double">
      <default>-10.0</default>
    </entry>
    <entry name="startupVolumeDb" type="Double">
      <default>-40.0</default>
    </entry>

    <!-- Master switch for the volume-feedback chime. Default true so
         existing installs keep it. Read via VolumeSettings.qml by both
         maybeChime()s (CompactRepresentation.qml, FlyoutContent.qml); when
         false devialet-chime is never spawned. -->
    <entry name="chimeEnabled" type="Bool">
      <default>true</default>
    </entry>

    <!-- Which sound the chime plays. chimeSourceMode: "follow" (no file
         argument; devialet-chime resolves kdeglobals' [Sounds] Theme
         itself), "theme" (chimePinnedTheme's audio-volume-change.oga) or
         "file" (chimeSoundFile). chimePinnedTheme is the sound-theme
         DIRECTORY id (ocean, freedesktop, ...) that kdeglobals stores,
         never the display name. chimeSoundFile is an absolute path; ""
         means nothing picked yet. Id-to-path resolution is
         contents/ui/SoundThemes.qml. -->
    <entry name="chimeSourceMode" type="String">
      <default>follow</default>
    </entry>
    <entry name="chimePinnedTheme" type="String">
      <default>ocean</default>
    </entry>
    <entry name="chimeSoundFile" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
